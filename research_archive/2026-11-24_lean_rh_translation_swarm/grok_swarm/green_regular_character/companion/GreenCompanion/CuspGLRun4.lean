def MassPartR3 : Prop := ∀ (F : Type) [Field F] [Finite F] (V : Type) [AddCommGroup V] [Module F V] [FiniteDimensional F V] (s : F[X] → ℂ), IsAdditive s → ∀ P : F[X], P.Monic → P.natDegree = Module.finrank F V → mass (psi s V) P = glCard F P.natDegree * mangoldt s P / ((Nat.card F : ℂ) ^ P.natDegree - 1)

theorem torusPart_of_deps (hZ : NotPrimaryPart) : TorusPartR3 := CuspGL.ipGL_rootSum_eq_sum_torus hZ

theorem massPart_of_deps (hConj : ConjPart) (hMu : MuRecPart) (hLog : LogConvPart) (hParMass : ParMassPart) (hPsiSum : PsiSumPart) (hCancel : CancelPart) (hMassEq : MassEqPart) : MassPartR3 :=
