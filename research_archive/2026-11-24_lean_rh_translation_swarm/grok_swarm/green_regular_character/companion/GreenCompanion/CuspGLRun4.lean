def ipGL {V : Type} [AddCommGroup V] [Module F V] (φ φ' : Module.End F V → ℂ) : ℂ :=
  ∑ᶠ g ∈ {g : Module.End F V | IsUnit g}, φ g * star (φ' g)

def extZero {d : ℕ} (χ : GL (Fin d) F → ℂ) (g : Module.End F (Fin d → F)) : ℂ :=
