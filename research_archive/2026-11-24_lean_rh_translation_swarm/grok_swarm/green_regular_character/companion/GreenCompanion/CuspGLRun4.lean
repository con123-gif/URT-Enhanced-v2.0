def mangoldt (s : F[X] → ℂ) (P : F[X]) : ℂ :=
  ∑ᶠ f ∈ {f : F[X] | f.Monic ∧ Irreducible f ∧ ∃ m : ℕ, 0 < m ∧ P = f ^ m}, s f

def conv (a b : F[X] → ℂ) (P : F[X]) : ℂ :=
