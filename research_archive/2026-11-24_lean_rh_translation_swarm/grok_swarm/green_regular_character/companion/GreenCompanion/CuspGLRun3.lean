  ∀ A : Submodule F V, A ≠ ⊥ → A ≠ ⊤ → ∀ g : Module.End F V, (∀ x ∈ A, g x ∈ A) →
    ∑ᶠ h ∈ nilRad A, φ (g + h) = 0

def IsAdditive (s : F[X] → ℂ) : Prop :=
  ∀ P Q : F[X], P.Monic → Q.Monic → s (P * Q) = s P + s Q

