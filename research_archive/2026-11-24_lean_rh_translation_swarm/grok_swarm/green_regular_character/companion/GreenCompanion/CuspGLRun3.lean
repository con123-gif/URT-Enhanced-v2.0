  ((P.map (algebraMap F (AlgebraicClosure F))).roots.map fun α => θ α ^ k).sum

def mass {V : Type} [AddCommGroup V] [Module F V] [FiniteDimensional F V] (φ : Module.End F V → ℂ)
    (P : F[X]) : ℂ :=
  ∑ᶠ g ∈ {g : Module.End F V | LinearMap.charpoly g = P}, φ g

