theorem sumWhGGPart_of_deps (hWJ : WJPart) (hWhMul : WhMulPart) (hBZ : BZPart) (hMir : MirPart) : SumWhGGPart :=
  GGSum.sum_wh_gg hWJ hWhMul hBZ hMir

/-- upstream `GlobalTheory.T.gelfandGraevCharacterGLn_norm_and_reciprocity`, now from the four leaves above. -/
theorem ggNorm_of_deps (hWJ : WJPart) (hWhMul : WhMulPart) (hBZ : BZPart) (hMir : MirPart) :
    ∀ (g : ℕ) [Fact g.Prime] (ψ : AddChar (ZMod g) ℂ), ψ ≠ 1 → ∀ n : ℕ, 0 < n →
      wh ψ (gg ψ n) = (g : ℂ) ^ n - (g : ℂ) ^ (n - 1) ∧ ∀ χ : Gn g n → ℂ, IsClass χ → ip χ (gg ψ n) = wh ψ χ :=
  GGNorm.gg_norm (sumWhGGPart_of_deps hWJ hWhMul hBZ hMir)

