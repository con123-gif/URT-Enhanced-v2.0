theorem indR_diag1_eq_hc_gg (g : ℕ) [Fact g.Prime] (ψ : AddChar (ZMod g) ℂ) (i k : ℕ) (ρ : Gn g i → ℂ)
    (hi : i ≤ k) (hρ : IsClass ρ) (h : Gn g k) :
    indR ψ i (k + 1) ρ (diag1 h (k + 1)) = hc i (k - i) ρ (gg ψ (k - i)) k h := by
  have e1 : ∀ y : Gn g (k + 1), (if InMir (y : Mt g (k + 1)) ∧
      InR i ((y⁻¹ * diag1 h (k + 1) * y : Gn g (k + 1)) : Mt g (k + 1)) then
        ρ (toG (tl i ((y⁻¹ * diag1 h (k + 1) * y : Gn g (k + 1)) : Mt g (k + 1)))) *
          ψ (supFrom i ((y⁻¹ * diag1 h (k + 1) * y : Gn g (k + 1)) : Mt g (k + 1))) else 0) =
      if InMir (y : Mt g (k + 1)) then
        fR ψ i ρ ((toG (tl k (y : Mt g (k + 1))))⁻¹ * h * toG (tl k (y : Mt g (k + 1)))) else 0 := by
    intro y
    by_cases hy : InMir (y : Mt g (k + 1))
    · rw [if_pos hy, ← fR_conj_diag1 ψ i k hi ρ h y hy, fR]
      simp only [hy, true_and]
    · rw [if_neg hy, if_neg (fun hh => hy hh.1)]
  have hg : (g : ℂ) ≠ 0 := Nat.cast_ne_zero.2 (Fact.out : g.Prime).ne_zero
  unfold indR
  rw [Finset.sum_congr rfl fun y _ => e1 y, sum_mir k (fun t => fR ψ i ρ (t⁻¹ * h * t)),
    card_inR_succ i k hi, ← stages ψ i k hi ρ hρ h, mul_inv_rev, mul_assoc,
    inv_mul_cancel_left₀ (pow_ne_zero _ hg)]

end GLm

/-- RUN5 leaf `T.mirabolicConjInvariant_eq_sum_induced_derivatives` (`MirConjPart`) from its four upstream deps. -/
theorem mirConjPart_of_deps (hTM : TailMirPart) (hMT : MirTailPart) (hPP : PhiPlusPart) (hDT : DerTailPart) :
    MirConjPart :=
  GLm.MirSum.eq_sum_indR_der hTM hMT hPP hDT
/-- RUN5 leaf `T.mirabolicInduction_blockDiag_eq_harishChandra_gelfandGraev` (`MirIndPart`) from its upstream dep. -/
theorem mirIndPart_of_deps (hBPp : BlockParPart) : MirIndPart := by
  haveI : BlockParH := ⟨hBPp⟩
  exact GLm.indR_diag1_eq_hc_gg
/-- RUN4 leaf `T.mirabolicClassFun_blockDiagonal_eq_sum_derivatives` (`MirPart`) from the current leaves. -/
theorem mirPart_of_leaves6 (hTM : TailMirPart) (hMT : MirTailPart) (hPP : PhiPlusPart) (hDT : DerTailPart)
    (hBPp : BlockParPart) : MirPart :=
  mirPart_of_deps (mirConjPart_of_deps hTM hMT hPP hDT) (mirIndPart_of_deps hBPp) derClassPart_holds
/-- RUN3 `SumWhGGPart` (= upstream `GLm.GGSum.sum_wh_gg`) from the current leaves (RUN6). -/
theorem sumWhGGPart_of_leaves6' (hWJ : WJPart) (hWhMul : WhMulPart) (hBZ : BZPart) (hTM : TailMirPart)
    (hMT : MirTailPart) (hPP : PhiPlusPart) (hDT : DerTailPart) (hBPp : BlockParPart) : SumWhGGPart :=
  sumWhGGPart_of_deps hWJ hWhMul hBZ (mirPart_of_leaves6 hTM hMT hPP hDT hBPp)

