theorem psiSumPart_holds : PsiSumPart := by first | exact @CuspGL.charpoly_eq_finsum_psi | exact CuspGL.charpoly_eq_finsum_psi | (intros; apply CuspGL.charpoly_eq_finsum_psi <;> assumption)
/-- upstream leaf `T.endomorphismMass_mul_parabolic_induction_trivial` (`ParMassPart`) from its three open deps. -/
theorem parMassPart_of_deps (hCB : CharpolyBlockPart) (hFS : FinsumStabPart) (hCS : CardSubPart) : ParMassPart := by
  haveI : CharpolyBlockH := ⟨hCB⟩
  haveI : FinsumStabH := ⟨hFS⟩
