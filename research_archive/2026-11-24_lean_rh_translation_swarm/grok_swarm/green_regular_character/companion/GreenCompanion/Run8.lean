  first | exact @CuspGL.MassMult.mass_mult | exact CuspGL.MassMult.mass_mult | (intros; apply CuspGL.MassMult.mass_mult <;> assumption)
/-- upstream `T.card_subspaces_of_finrank_mul_card_bases`: closed (statement type checked by the wrapper below). -/
theorem cardBasesPart_holds : ∀ (F : Type) [Field F] [Finite F] (V : Type) [AddCommGroup V] [Module F V] [FiniteDimensional F V] (a : ℕ), a ≤ Module.finrank F V → Nat.card {W : Submodule F V // Module.finrank F W = a} * ∏ i ∈ Finset.range a, (Nat.card F ^ a - Nat.card F ^ i) = ∏ i ∈ Finset.range a, (Nat.card F ^ Module.finrank F V - Nat.card F ^ i) := by first | exact @SubspaceNumber.card_subspaces_mul | exact SubspaceNumber.card_subspaces_mul | (intros; apply SubspaceNumber.card_subspaces_mul <;> assumption)
/-- upstream `T.charpoly_block_and_invariant_under_stabilizerNilradical` (`CharpolyBlockPart`): closed. -/
theorem charpolyBlockPart_holds : CharpolyBlockPart := by first | exact @CuspGL.charpoly_block | exact CuspGL.charpoly_block | (intros; apply CuspGL.charpoly_block <;> assumption)
/-- upstream `T.finsum_subspaceStabilizer_mul_block_functions` (`FinsumStabPart`): closed. -/
