theorem ggNorm_of_leaves8 (hWJ : WJPart) (hWhMul : WhMulPart) :
    ∀ (g : ℕ) [Fact g.Prime] (ψ : AddChar (ZMod g) ℂ), ψ ≠ 1 → ∀ n : ℕ, 0 < n →
