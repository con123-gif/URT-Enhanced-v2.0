namespace RHFormalAuditOddSha0048

theorem exact_annihilator_payment {R : Type*} [CommRing R]
    (A B X S k b z : R)
    (hA : S*A*z = 0) (hB : B*X = k*S) (hX : X = A*B*b) :
    X^2*z = 0 := by
  calc
    X^2*z = (B*X)*(A*b*z) := by
      calc
        X^2*z = X*X*z := by ring
        _ = (A*B*b)*X*z := congrArg (fun t => t*X*z) hX
        _ = (B*X)*(A*b*z) := by ring
    _ = (k*S)*(A*b*z) := by rw [hB]
    _ = (k*b)*(S*A*z) := by ring
    _ = 0 := by rw [hA, mul_zero]

theorem original_annihilator_bridge {R : Type*} [CommRing R]
    (X z : R) (h : 2*X^2*z = 0) : 4*X^2*z = 0 := by
  calc
    4*X^2*z = 2*(2*X^2*z) := by ring
    _ = 0 := by rw [h, mul_zero]

