      (r.comp (res Rat Omega K)) := by
  have hC := UpperTheory.V.Lev.LevelF.of_level hlevel
  have hF := UpperTheory.V.Lev.levelFRes Rat K Omega l 2 M
    (![(e : Int), -(e : Int)] : Fin 2 -> Int) r hC
  obtain ⟨⟨P, hreg, hA⟩, hW⟩ := haut hC.cont K hK hirrK
  obtain ⟨theta, htheta, hd⟩ := hdual
  obtain ⟨chi, mu, hpol, -, -⟩ :=
    UpperTheory.V.Z.Bc.polarization_k_of_printed_results hP K hK 2 (by omega)
      l Omega iota r 0 theta P htheta hd hA
  exact ⟨hirrK, ⟨P, hreg, ⟨chi, hpol⟩, hA⟩, hW, hF,
    safePA_rankTwo_weights he (r.comp (res Rat Omega K))⟩

def RankTwoWeight (m : Fin 2 → ℤ) (wt : ℤ) : Prop :=
  ∃ e : ℕ, 1 ≤ e ∧ m = ![(e : ℤ), -(e : ℤ)] ∧ wt = 0

theorem rankTwo_admResFamily (hP : _root_.UpperTheory.V.Af.Hypotheses') :
    AdmResFamily 2 RankTwoWeight := by
  intro K _ _ _ hK m wt hfamily hm M hM l _ hl Ω _ _ _ _ _ _ ι r hr hirr
  obtain ⟨e, he, rfl, rfl⟩ := hfamily
  exact admissible_restriction_rankTwo_of_core hP K hK e he M l Ω ι r
    hr.aut hr.level hr.dual hirr

theorem rankTwo_count (hP : _root_.UpperTheory.V.Af.Hypotheses')
    (hL : _root_.UpperTheory.GalN.V.LevelPNAlt) :
    CountQFamily 2 RankTwoWeight := by
  first
  | (rh_reduce 2 using [countQ_alt_of_family 2 le_rfl RankTwoWeight hP hL
       (rankTwo_admResFamily hP)]; done)
  | (rh_auto_frontier 2; done)
  | (rh_auto 2; done)
  | exact countQ_alt_of_family 2 le_rfl RankTwoWeight hP hL (rankTwo_admResFamily hP)

