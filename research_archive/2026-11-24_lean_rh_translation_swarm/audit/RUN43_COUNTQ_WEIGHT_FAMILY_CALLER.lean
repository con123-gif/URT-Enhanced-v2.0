def AdmResFamily (n : ℕ) (P : (Fin n → ℤ) → ℤ → Prop) : Prop :=
  ∀ (K : Type) [Field K] [NumberField K] [IsCMField K], Module.finrank ℚ K = 2 → ∀ (m : Fin n → ℤ) (wt : ℤ), P m wt →
    StrictAnti m → ∀ M : ℕ, 1 ≤ M → ∀ (l : ℕ) [Fact l.Prime], l ≠ 2 → ∀ (Ω : Type) [Field Ω] [Algebra ℚ Ω] [Algebra K Ω]
    [IsScalarTower ℚ K Ω] [IsAlgClosure ℚ Ω] [IsAlgClosure K Ω] (ι : Qbar l ≃+* ℂ) (r : G ℚ Ω →* GL (Fin n) (Qbar l)),
      _root_.UpperTheory.GalN.V.AdmRNAlt ι M m wt r → IsIrr (r.comp (res ℚ Ω K)) → _root_.UpperTheory.GalN.V.AdmPNAlt ι M m (r.comp (res ℚ Ω K))

def CountQFamily (n : ℕ) (P : (Fin n → ℤ) → ℤ → Prop) : Prop :=
  ∃ c A : ℕ,
    ∀ (m : Fin n → ℤ) (wt : ℤ), P m wt → StrictAnti m → (∀ i, m i + m i.rev = wt) → ∀ H : ℕ, (∀ i, |m i| ≤ H) → ∀ M : ℕ, 1 ≤ M →
    ∀ (p : ℕ) (w : HeightOneSpectrum (𝓞 ℚ)), p.Prime → (p : 𝓞 ℚ) ∈ w.asIdeal → ¬ p ∣ M →
      ∃ D : EigData n p m wt, Nat.card D.S ≤ c * (M * (H + 1)) ^ A ∧
        ∀ (l : ℕ) [Fact l.Prime], l ≠ 2 → l ≠ p → ∀ (Ω : Type) [Field Ω] [Algebra ℚ Ω] [IsAlgClosure ℚ Ω] (ι : Qbar l ≃+* ℂ),
          D.Classifies (Ω := Ω) ι w (_root_.UpperTheory.GalN.V.AdmRNAlt ι M m wt)

