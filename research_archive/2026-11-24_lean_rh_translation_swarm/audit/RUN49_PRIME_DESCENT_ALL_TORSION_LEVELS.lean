example (hNorm : PrimeDescent49)
    (L F : Type) [Field L] [NumberField L] [Field F] [NumberField F] [Algebra L F]
    (l c ν a g r : ℕ) (ζ : (𝓞 F)ˣ) (γ : F ≃ₐ[L] F)
    (D : Dat (Additive Fˣ) (HeightOneSpectrum (𝓞 F) →₀ ℤ)) [Finite D.W]
    (hl : l.Prime) (hLay : Lay l c ν ζ γ) (hD : IsDat γ a D)
    (hFin : Finite (SelL l L)) (hBase : Nat.card (SelL l L) ≤ l^(g+1))
    (hdvd : (l : ℤ) ∣ (D.a : ℤ)-1) :
    Nat.card (Submodule.torsionBy ℤ D.W ((l : ℤ)^r)) ≤ l^(r*g) := by
  first
  | (rh_reduce 2 using [fixedBudget49]; done)
  | (rh_auto_frontier 2; done)
  | (rh_auto 2; done)
  | exact fixedBudget49 hNorm L F l c ν a g r ζ γ D hl hLay hD hFin hBase hdvd

