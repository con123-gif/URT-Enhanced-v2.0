    obtain ⟨χ, -, h2, -⟩ := hκ
    exact Or.inl (A4.unlOfOne K Ω l n r w A hA κ h2 hu)) hW hreg hpol ha
  exact ⟨⟨h.1, hpol, h.2.1⟩, h.2.2⟩

