theorem levelPN_gap44 (P : _root_.UpperTheory.V.Af.Hypotheses') : LevelPNGap44 := by
  intro K _ _ _ _ n hn m _ M hM l _ hl Ω _ _ _ ι r π hL hg hW hreg hpol ha
