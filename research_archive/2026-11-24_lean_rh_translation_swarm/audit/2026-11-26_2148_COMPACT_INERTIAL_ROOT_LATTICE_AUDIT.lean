namespace RHInertialRootAudit

-- Independent exact cancellation, conditional only on the two polynomial identities.
theorem bezout_transfer {S A : Type*} [Ring S] [Ring A] (f : S →+* A)
    (H P G Q a b c : S)
    (hH : f H = 0) (hP : f P = 0)
    (hG : G = a * H + b * P) (hQ : Q = c * G) : f Q = 0 := by
  rw [hQ, hG]
  simp [map_mul, map_add, hH, hP]

-- Native comparison; check with the pinned compact toolchain, not the old pin.
theorem radical_transfer_native {K A : Type*} [Field K] [IsAlgClosed K]
    [CharZero K] [Ring A] (f : Polynomial K →+* A)
    {P Q : Polynomial K}
    (hN : ∃ n : ℕ, n > 0 ∧ f Polynomial.X ^ n = 1)
    (hP : f P = 0)
    (hRoots : ∀ x : K, P.IsRoot x → Q.IsRoot x) : f Q = 0 :=
  map_eq_zero_of_roots f hN hP hRoots

end RHInertialRootAudit

