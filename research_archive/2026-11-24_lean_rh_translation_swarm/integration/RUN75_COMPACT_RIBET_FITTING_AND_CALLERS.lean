namespace CompactIntegrationRun75

theorem ordered_error_step {R : Type*} [CommRing R] (I : Ideal R)
    (q g p z b : R) (hz : q * z ∈ I) :
    q * (g * p + z) * b - q * (g * p) * b ∈ I := by
  convert I.mul_mem_left b hz using 1 <;> ring

theorem exact_budget (t j s c u b0 b : ℕ) :
    b0 + c + t * (u + s*c) + (b + (j+t*s)*c) =
    b0 + b + t*u + (2*t*s+j+1)*c := by ring

