namespace RHStructure39

def ambientBudget {k : ℕ} (r : ℕ) (a : Fin k → ℕ) (d : ℕ) : ℕ :=
  r * d + ∑ i, min d (a i - 2)

theorem budget_le {k r R : ℕ} (a : Fin k → ℕ) (d : ℕ)
    (hR : r + k ≤ R) : ambientBudget r a d ≤ R * d := by
  classical
  have hs : (∑ i : Fin k, min d (a i - 2)) ≤ ∑ _i : Fin k, d :=
    Finset.sum_le_sum fun i _ => min_le_left _ _
  have ht : (∑ i : Fin k, min d (a i - 2)) ≤ k * d := by
    simpa using hs
  unfold ambientBudget
  calc
    _ ≤ r * d + k * d := Nat.add_le_add_left ht _
    _ = (r+k)*d := by rw [Nat.add_mul]
    _ ≤ R*d := Nat.mul_le_mul_right d hR

theorem budget_zero {k r : ℕ} (a : Fin k → ℕ) :
    ambientBudget r a 0 = 0 := by simp [ambientBudget]

-- Cardinality-to-length interface after the actual torsion inclusion.
theorem finite_torsion_le {A B : Type*} [Fintype A] [Fintype B]
    (f : A → B) (hf : Function.Injective f)
    (l s t : ℕ) (hl : 1 < l)
    (hA : Fintype.card A = l^s) (hB : Fintype.card B = l^t) :
    s ≤ t := by
  have hc := Fintype.card_le_of_injective f hf
  rw [hA,hB] at hc
  by_contra hn
  have hst : t < s := by omega
  exact (not_le_of_gt (Nat.pow_lt_pow_right hl hst)) hc

-- Scalar DVR structure-theorem output, not a claim to derive it.
theorem image_length_bound {k r s t : ℕ} (a : Fin k → ℕ) (d : ℕ)
    (hr : s ≤ r) (ht : t ≤ ∑ i, min d (a i - 2)) :
    s*d+t ≤ ambientBudget r a d := by
  exact Nat.add_le_add (Nat.mul_le_mul_right d hr) ht

theorem uniform_anchor39 {l : ℕ} [Fact l.Prime] {L₀ : Type}
    [Field L₀] [NumberField L₀] {γ : G L₀ (AlgebraicClosure L₀)}
    (h : Descends l L₀ γ) (R r k : ℕ) (a : Fin k → ℕ)
    (hGrowth : ∀ e : ℕ, 1 ≤ e → ∀ m : ℕ,
      twLen (xRep l l (⊤ : Subgroup (G L₀ (AlgebraicClosure L₀))) γ)
        (cycZ L₀ _ l γ : ℤ_[l]) e m ≤
      twLen (xRep l l (⊤ : Subgroup (G L₀ (AlgebraicClosure L₀))) γ)
        (cycZ L₀ _ l γ : ℤ_[l]) e (jZero l R) +
      (ambientBudget r a (m-jZero l R) : ℕ∞)) :
    ∀ e : ℕ, 1 ≤ e → ∀ (m : ℕ) (L₁ : Type)
      [Field L₁] [NumberField L₁] [Algebra L₀ L₁], IsLayer l m L₀ L₁ →
      ∀ (L₂ : Type) [Field L₂] [NumberField L₂] [Algebra L₀ L₂],
        IsLayer l (jZero l R) L₀ L₂ →
        shaInv L₁ l e ≤ shaInv L₂ l e +
          (ambientBudget r a (m-jZero l R) : ℕ∞) := by
  intro e he m L₁ _ _ _ h₁ L₂ _ _ _ h₂
  rw [h.eq_twLen he h₁, h.eq_twLen he h₂]
  exact hGrowth e he m

example {k r R : ℕ} (a : Fin k → ℕ) (d : ℕ) (hR : r+k ≤ R) :
    ambientBudget r a d ≤ R*d := by
  first
  | (rh_reduce 2 using [budget_le]; done)
  | (rh_auto_frontier 2; done)
  | (rh_auto 2; done)
  | exact budget_le a d hR

