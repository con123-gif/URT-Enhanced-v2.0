/-- One actual selected record, with all original guards but no universal
quantification over data and no separate base/secondary record. -/
def SelectedBudgetOn (P : Parameters) (eps : ℝ) (K : ℕ) (C : ℝ) (A : Set ℝ) : Prop :=
  ∀ᶠ x in atTop, x ∈ A → ∃ D : Data P, D.x = x ∧
    log D.logB = eps * D.logX ∧ towerDeg D.s / D.logB ≤ #D.thick ∧
    1e6 * D.logX ≤ D.logX₁ ∧ D.logX₁ ≤ (1e6 * D.logX)^2 ∧
    primeError P.d P.N₀ D.x₁ - towerDeg D.s / #D.thick * primeError P.d 1 D.x₁ ≤
      exp (-(1e6 * D.logX)) ∧
    D.m * D.run90Remainder ≤ C * (D.f : ℝ) * (D.a : ℝ) * D.logB^K

theorem selected_of_guarded (P : Parameters) {eps : ℝ}
    (he : 0 < eps / 6 ∧ eps < 1 / 100) (K : ℕ) (C : ℝ) (A : Set ℝ)
    (hstar : RHIntegration97.GuardedBudgetOn P eps K C A) :
    SelectedBudgetOn P eps K C A := by
  unfold RHIntegration97.GuardedBudgetOn at hstar
  unfold SelectedBudgetOn
  filter_upwards [he.elim (exists_data P), tendsto_log_atTop.const_mul_atTop (r := 1e6) (by bound)
    ((isPolar_primeError PrimeSevenModEight.mod_eight (P.coprime_N₁_d
    0).coprime_mul_right).exists_window_sub_mul_le (isPolar_primeError PrimeSevenModEight.mod_eight
    P.d.coprime_one_left)), hstar] with x ⟨D, _, _, l, e, H'⟩ W hs
  intro hxS
  subst x; simp only [log_exp, Set.mem_preimage, ← exp_mul] at *
  obtain := D.hasLogLower_of_le H', D.scale
  obtain ⟨u, ⟨a, b⟩, w⟩ := W (towerDeg D.s / #D.thick) ⟨by bound, D.le_of_hasLogBound⟩
  let D' := {D with logX₁ := u, scale := by grw [b, l] <;> grind}
  have := D'.hasLogLower_of_le H'
  exact ⟨D', rfl, e, H', a, b, w, hs hxS D' rfl e H' a b w⟩

theorem eventually_primeError_on_set (P : Parameters) {eta eps : ℝ}
    (heta : 0 < eta) (K : ℕ) (C : ℝ) (hC : 0 ≤ C)
    (hslack : ((K : ℝ)+1)*eps ≤ eta)
    (A : Set ℝ) (hstar : SelectedBudgetOn P eps K C A) :
    ∀ᶠ x in atTop, x ∈ A → primeError P.d P.N₀ x ≤ x ^ (8 * eta + 2⁻¹ - 1) := by
  unfold SelectedBudgetOn at hstar
  have hthreshold : ∀ᶠ x : ℝ in atTop,
      log (C * (P.N₀.totient : ℝ) + 1)/(7*eta) ≤ log x :=
    tendsto_log_atTop (mem_atTop _)
  filter_upwards [hstar, hthreshold, (mem_atTop (1 : ℝ))] with x hs hab hx
  intro hxS
  obtain ⟨D,hDx,e,H',_,_,w,starD⟩ := hs hxS
  subst x; simp only [log_exp, Set.mem_preimage, ← exp_mul] at *
  obtain := D.hasLogLower_of_le H', D.scale
  have hm : (0 : ℝ) < D.m := HasLogBound.pos D
  have ha : (0 : ℝ) < D.a := HasLogBound.pos D
  have hH : (0 : ℝ) < #D.thick := HasLogBound.pos D
  have hB : 0 < D.logB := HasLogBound.pos D
  have hX : 0 ≤ D.logX := exp_le_exp.mp (by simpa only [exp_zero] using hx)
  have hf : (D.f : ℝ) = (towerDeg D.s : ℝ)*(P.N₀.totient : ℝ) := by
    rw [Data.f.eq_1, P.card_infinitePlace_E]
    push_cast <;> ring
  have hAbsorb : log (C*(P.N₀.totient : ℝ)+1) ≤ 7*eta*D.logX := by
    have h := (div_le_iff₀ (by positivity : 0 < 7*eta)).mp hab
    simpa [mul_comm] using h
  calc primeError P.d P.N₀ D.x = D.m * D.run90Remainder / D.m / D.a / #D.thick + (primeError P.d P.N₀
      D.x₁ - towerDeg D.s / #D.thick * primeError P.d 1 D.x₁) := by simp [run90Remainder_eq, tops,
      card_placeClass_eq, field, HasLogBound.pos D, ne_of_gt]
    _ ≤ exp (D.logX*(8*eta+2⁻¹-1)) :=
      RHIntegration97.finite_power_scalar _ _ _ _ _ _ _ _ _ C eta eps D.logX K
        hm ha hH hB (by positivity) hC heta hX hf H' D.m_mem.1 e hslack starD w hAbsorb
    _ = D.x ^ (8*eta+2⁻¹-1) := by rw [Real.rpow_def_of_pos (exp_pos _), log_exp]

theorem endpoint_from_selected (P : Parameters) {eta eps : ℝ}
    (heta : 0 < eta)
    (K : ℕ) (C : ℝ) (hC : 0 ≤ C) (hslack : ((K : ℝ)+1)*eps ≤ eta)
    (h : SelectedBudgetOn P eps K C RHPrimeWindow94.QuarticScales) :
    RHPrimeWindow88.EndpointGrid P.d P.N₀ eta := by
  obtain ⟨X,hX⟩ := Filter.eventually_atTop.1
    (eventually_primeError_on_set P heta K C hC hslack
      RHPrimeWindow94.QuarticScales h)
  obtain ⟨J,hJ⟩ := exists_nat_gt (max X 1)
  refine ⟨J, ?_⟩
  intro k hk
  have hKk : (J : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hk1 : (1 : ℝ) ≤ (k : ℝ) :=
    (le_max_right X 1).trans (hJ.le.trans hKk)
  have hk4 : (k : ℝ) ≤ (k : ℝ)^4 := by
    have hk0 : (0 : ℝ) ≤ (k : ℝ) := by positivity
    have h2 : (k : ℝ) ≤ (k : ℝ)^2 := by
      nlinarith [mul_nonneg hk0 (sub_nonneg.mpr hk1)]
    have h2one : (1 : ℝ) ≤ (k : ℝ)^2 := hk1.trans h2
    have h4 : (k : ℝ)^2 ≤ (k : ℝ)^4 := by
      nlinarith [mul_nonneg (sq_nonneg (k : ℝ)) (sub_nonneg.mpr h2one)]
    exact h2.trans h4
  exact hX _ ((le_max_left X 1).trans (hJ.le.trans (hKk.trans hk4))) ⟨k,rfl⟩

def SelectedCountBudget : Prop :=
  ∀ ε : ℝ, 0 < ε / 6 ∧ ε < 1 / 100 → ∃ S : Set ℕ,
    RHDepCountEscape82.CountEscape S (4 * ε / 9) ∧
    ∀ d : Primes, d.1 ∈ S → ∃ P : Parameters,
      P.d = d ∧ P.N₀ = 18480 ∧
      ∃ (eps : ℝ) (K : ℕ) (C : ℝ),
        (0 < eps / 6 ∧ eps < 1 / 100) ∧ 0 ≤ C ∧
        ((K : ℝ) + 1) * eps ≤ ε / 2 ∧
        SelectedBudgetOn P eps K C RHPrimeWindow94.QuarticScales

theorem count_escape_grid_from_selected (h : SelectedCountBudget) :
    RHDepCountEscape82.CountEscapeGrid := by
  intro ε he
  obtain ⟨S, hcount, hS⟩ := h ε he
  refine ⟨S, hcount, ?_⟩
  intro d hd
  obtain ⟨P, hPd, hPM, eps, K, C, heps, hC, hslack, hbudget⟩ := hS d hd
  have heta : 0 < ε / 2 := by linarith [he.1]
  have hgrid : RHPrimeWindow88.EndpointGrid P.d P.N₀ (ε / 2) :=
    endpoint_from_selected P heta K C hC hslack hbudget
  have hguards : P.d.1 % 8 = 7 ∧ P.N₀.Coprime P.d :=
    ⟨P.instHeegD.2, (P.coprime_N₁_d 0).coprime_mul_right⟩
  simpa only [hPd, hPM] using And.intro hguards hgrid

theorem zeta_line_from_selected_count (h : SelectedCountBudget) :
    RiemannZetaZerosOnLine :=
  RHDepCountEscape82.zeta_line_from_count_escape_grid (count_escape_grid_from_selected h)

theorem selected_count_of_old (h : RHPrimeWindow98.CountEscapeBudget) : SelectedCountBudget := by
  intro ε he
  obtain ⟨S,hcount,hS⟩ := h ε he
  refine ⟨S,hcount,?_⟩
  intro d hd
  obtain ⟨P,hPd,hPM,eps,K,C,heps,hC,hslack,hbudget⟩ := hS d hd
  exact ⟨P,hPd,hPM,eps,K,C,heps,hC,hslack,
    selected_of_guarded P heps K C RHPrimeWindow94.QuarticScales hbudget⟩

