theorem len_card_exact (l : ℕ) [Fact l.Prime] (L Ω : Type)
    [Field L] [NumberField L] [Field Ω] [Algebra L Ω] [IsAlgClosure L Ω]
    (D : LData L Ω l) (e : ℕ)
    (hfin : Finite (ReciprocityTheory.Gal.H2 (zlTw D ((e : ℤ) + 1)))) :
    VLen D (e : ℤ) ≠ ⊤ ∧
      Real.log (Nat.card (ReciprocityTheory.Gal.H2 (zlTw D ((e : ℤ) + 1))) : ℝ) =
        ((VLen D (e : ℤ)).toNat : ℝ) * Real.log (l : ℝ) := by
  letI : Finite (ReciprocityTheory.Gal.H2 (zlTw D ((e : ℤ) + 1))) := hfin
  obtain ⟨k, hlen, hcard⟩ :=
    Kum.lenOfCard l (ReciprocityTheory.Gal.H2 (zlTw D ((e : ℤ) + 1)))
  have hv : VLen D (e : ℤ) = (k : ℕ∞) := hlen
  refine ⟨by rw [hv]; exact ENat.coe_ne_top k, ?_⟩
  rw [hv, ENat.toNat_coe, hcard]
  push_cast
  rw [Real.log_pow]

def BoundedCardOne : Prop :=
  ∀ n0 : ℕ, ∃ A : ℕ, ∀ (l : ℕ) [Fact l.Prime] (L Ω : Type)
    [Field L] [NumberField L] [Field Ω] [Algebra L Ω] [IsAlgClosure L Ω]
    (D : LData L Ω l) (N : ℕ), l ≠ 2 → 2 ≤ N →
    Module.finrank ℚ L ≤ n0 → Nonempty (L →ₐ[ℚ] CyclotomicField (l * N) ℚ) →
    Finite (ReciprocityTheory.Gal.H2 (zlTw D (2 : ℤ))) ∧
      Real.log (Nat.card (ReciprocityTheory.Gal.H2 (zlTw D (2 : ℤ))) : ℝ) ≤
        ((l : ℝ) * N) ^ A

theorem bounded_weight_one_of_card (h : BoundedCardOne) :
    RHBoundedWeightOne34.BoundedWeightOne := by
  intro n0
  obtain ⟨A, hA⟩ := h n0
  refine ⟨A, ?_⟩
  intro l _ L Ω _ _ _ _ _ D N hl hN hd hc
  obtain ⟨hf, hlog⟩ := hA l L Ω D N hl hN hd hc
  obtain ⟨hne, heq⟩ := len_card_exact l L Ω D 1 hf
  have hl2 : (2 : ℝ) ≤ l := by exact_mod_cast (Fact.out : l.Prime).two_le
  have hlogl : (1 / 2 : ℝ) ≤ Real.log l := by
    have h1 := Real.log_le_log (by norm_num : (0 : ℝ) < 2) hl2
    have h2 : (1 / 2 : ℝ) < Real.log 2 := by
      have := Real.log_two_gt_d9
      linarith
    linarith
  refine ⟨hne, ?_⟩
  have hk0 : (0 : ℝ) ≤ ((VLen D ((1 : ℕ) : ℤ)).toNat : ℝ) := Nat.cast_nonneg _
  have hh := mul_le_mul_of_nonneg_left hlogl hk0
  change Real.log (Nat.card (ReciprocityTheory.Gal.H2
    (zlTw D (((1 : ℕ) : ℤ) + 1))) : ℝ) ≤ ((l : ℝ) * N) ^ A at hlog
  rw [heq] at hlog
  linarith

theorem countVs_of_card :
    GlobalTheory.Published.PoitouTateDuality → LocalFinitenessK →
    LocalTateDualityK → BoundedCardOne → CountVs := by
  intro hp hf ht hc
  exact RHBoundedWeightOne34.countVs_of_bounded_weight_one hp hf ht
    (bounded_weight_one_of_card hc)

