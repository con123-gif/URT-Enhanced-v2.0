theorem level_envelope (m W w G : ℝ)
    (hm : 100 ≤ m) (hW : 0 ≤ W)
    (hw0 : 0 ≤ w) (hw1 : w ≤ 2 * W)
    (hG0 : 2 * W ≤ G) (hG1 : G ≤ 27 * W) :
    m * W ≤ m * w + (m - 1) * G - (15 / 2 : ℝ) * W ∧
    m * w + (m - 1) * G - (15 / 2 : ℝ) * W ≤ 29 * m * W := by
  have hm0 : 0 ≤ m := by linarith
  have hm1 : 0 ≤ m - 1 := by linarith
  have hlow := mul_le_mul_of_nonneg_left hG0 hm1
  have hhigh := mul_le_mul_of_nonneg_left hG1 hm1
  have hwlow := mul_nonneg hm0 hw0
  have hwhigh := mul_le_mul_of_nonneg_left hw1 hm0
  have hmargin := mul_nonneg (show 0 ≤ m - (19 / 2 : ℝ) by linarith) hW
  constructor <;> nlinarith

theorem last_star_guard (W B X logTerm : ℝ)
    (hW : 35 ≤ W) (hB : 0 ≤ B)
    (hX : X ≤ B) (hlog : logTerm ≤ 3 * W) :
    4 * W * B + 4 * X + 10 * logTerm * B ≤ W ^ 2 * B := by
  have h1 := mul_le_mul_of_nonneg_right hlog hB
  have h2 : 34 * W + 4 ≤ W ^ 2 := by
    nlinarith [mul_nonneg (show 0 ≤ W - 35 by linarith)
      (show 0 ≤ W + 1 by linarith)]
  have h3 := mul_le_mul_of_nonneg_right h2 hB
  nlinarith

end CompactPrimeWindow54

