open Formalism.HC
open Formalism.BasicNotions Formalism.MainNotions
noncomputable section

namespace RHPrincipalNative

theorem cyc_one_kept : (Level.cyc PChar.one).KEPT = {PChar.one} := by
  classical
  ext p
  simp only [Finset.mem_singleton]
  constructor
  · intro hp
    change p ∈ (Level.ofSub (Subgroup.zpowers PChar.one.χ)).KEPT at hp
    obtain ⟨χ, hχ, hof⟩ := (Level.mem_ofSub _ _).1 hp
    have hone : PChar.one.χ = 1 := rfl
    rw [hone] at hχ
    obtain ⟨k, hk⟩ := hχ
    have hc : χ = 1 := by
      first | simpa using hk.symm | simpa using hk
    rw [hc, PChar.of_one] at hof
    exact hof.symm
  · rintro rfl
    exact Level.mem_cyc PChar.one

theorem cyc_one_gm (x : ℝ) : (Level.cyc PChar.one).Gm x = Deduction.G x := by
  classical
  calc
    (Level.cyc PChar.one).Gm x = Formalism.Gz x := by
      simp [Level.Gm, Level.Nt, cyc_one_kept]
    _ = Deduction.G x := (UpperTheory.Comparison₂.Gz_eq x).1.trans
      (UpperTheory.Comparison₂.Gz_eq x).2

open UpperTheory.Top in
theorem principal_window_of_topG {la : ℝ} (hla : 1 < la) (h : TopG)
    (hS : HostExW la (GChi PChar.one).req) :
    ∀ E : ℝ, 0 < E → HasWindows {x | Deduction.G x ≤ x ^ ((1 : ℝ) / 2 + E)} la := by
  intro E hE
  obtain ⟨eD, eL, ε₁, h1, h2⟩ :=
    h la (GChi PChar.one) hla hS (hypV_of_cls PChar.one la)
  obtain ⟨eps, he, hlt, hCe⟩ := exists_small_eps (eD + eL + 7) hE h1
  obtain ⟨Fm, c, d⟩ := h2 eps he hlt
  obtain ⟨x1, hx⟩ :=
    UpperTheory.Comparison₂.level_gm_le_on_family_scales (Level.cyc PChar.one)
      eD eL eps he Fm (eFamC_of_cls PChar.one la Fm c) d
  refine ((windows_iff _ la).1 c.1).mono (x0 := max x1 1) ?_
  intro x hxx hw
  change Deduction.G x ≤ _
  rw [← cyc_one_gm]
  exact (hx x (le_of_max_le_left hxx) hw).trans
    (Real.rpow_le_rpow_of_exponent_le (le_of_max_le_right hxx) (by linarith))

theorem principal_right_of_window {la : ℝ} (hla : 1 < la)
    (hW : ∀ E : ℝ, 0 < E → HasWindows {x | Deduction.G x ≤ x ^ ((1 : ℝ) / 2 + E)} la) :
    ∀ s : ℂ, 1 / 2 < s.re → s ≠ 1 → riemannZeta s ≠ 0 := by
  intro s hs _
  have hm0 : 0 < min (s.re - 1 / 2) (1 / 2) := lt_min (by linarith) (by norm_num)
  have hm1 := min_le_left (s.re - 1 / 2) (1 / 2)
  have hm2 := min_le_right (s.re - 1 / 2) (1 / 2)
  let E : ℝ := min (s.re - 1 / 2) (1 / 2) / 2
  have he : 0 < E := by dsimp [E]; linarith
  have h0 : 0 < (1 : ℝ) / 2 + E := by linarith
  have h1 : (1 : ℝ) / 2 + E < 1 := by dsimp [E]; linarith
  have h2 : (1 : ℝ) / 2 + E < s.re := by dsimp [E]; linarith
  have hw : HasWindows {x | (Level.cyc PChar.one).Gm x ≤ x ^ ((1 : ℝ) / 2 + E)} la := by
    simpa only [cyc_one_gm] using hW E he
  have hn := (UpperTheory.Comparison₂.formB (Level.cyc PChar.one) la hla
    ((1 : ℝ) / 2 + E) h0 h1 hw) PChar.one (Level.mem_cyc PChar.one) s h2
  change DirichletCharacter.LFunction (1 : DirichletCharacter ℂ 1) s ≠ 0 at hn
  rwa [DirichletCharacter.LFunction_modOne_eq] at hn

open UpperTheory.Top in
theorem principal_rh {la : ℝ} (hla : 1 < la) (h : TopG)
    (hS : HostExW la (GChi PChar.one).req) : RiemannHypothesis :=
  Formalism.VW.rh_of_right (principal_right_of_window hla (principal_window_of_topG hla h hS))

end RHPrincipalNative

rh_scan UpperTheory.Top.zeroFreeAll_of_topG limit 2000
rh_scan UpperTheory.Comparison₂.level_gm_le_on_family_scales limit 2000
rh_scan UpperTheory.Comparison₂.formB limit 2000
rh_scan RHPrincipalNative.principal_rh limit 2000
