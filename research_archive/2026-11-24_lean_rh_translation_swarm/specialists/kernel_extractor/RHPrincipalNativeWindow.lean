open UpperTheory.Top in
theorem RHPrincipalSearch {la : ℝ} (hla : 1 < la) (h : TopG)
    (hS : HostExW la (GChi PChar.one).req) : RiemannHypothesis := by
  first
  | (rh_reduce 4 using [Formalism.VW.rh_of_right, RHPrincipalNative.principal_right_of_window,
      RHPrincipalNative.principal_window_of_topG]; done)
  | exact RHPrincipalNative.principal_rh hla h hS

