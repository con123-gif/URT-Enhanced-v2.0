namespace CompactCharacterBoxes58

theorem quartic_obstruction {K : Type*} [Field K] (A B a : K)
    (hA : A ≠ 0) (ht : A^4 = B^4)
    (hs : 4*(A^4+B^4)+(a*A*B)^2=0) : a^4=64 := by
  rw [← ht] at hs
  have he : a^2*(A*B)^2 = -8*A^4 := by
    calc
      _ = (a*A*B)^2 := by ring
      _ = _ := by linear_combination hs
  have hprod : (a^4-64)*A^8=0 := by
    calc
      _ = a^4*(A^4*B^4)-64*A^8 := by rw [← ht]; ring
      _ = (a^2*(A*B)^2)^2-(-8*A^4)^2 := by ring
      _ = 0 := by rw [he]; ring
  rcases mul_eq_zero.mp hprod with h | h
  · exact sub_eq_zero.mp h
  · exact False.elim ((pow_ne_zero 8 hA) h)

theorem sup_contraction (M : ℝ) (hM : 1 ≤ M) (h : M^4 ≤ M^2) :
    M = 1 := by
  by_contra hn
  have hh : 1 < M := lt_of_le_of_ne hM (Ne.symm hn)
  have hsq : 1 < M^2 := by nlinarith [sq_nonneg (M-1)]
  have hp := mul_pos (sub_pos.mpr hsq) (show 0 < M^2 by linarith)
  nlinarith

theorem local_cubic_cancel {K : Type*} [CommRing K] (X Y a : K)
    (h : Y^2+a*X*Y=X^3+X) : X=Y^2+a*X*Y-X^3 := by
  linear_combination -h

