    Lean.throwError "RUN88 missing original star control body"
  unless originalValue.getUsedConstants.contains ``Data.integral_forms_long &&
      originalValue.getUsedConstants.contains ``Data.exists_family_covolumeSq_le do
    Lean.throwError "RUN88 original star lost its actual A/B/C supplier"
  for (name, supplier) in [
      (``run86_single_witness_star_inequality, ``Data.run86_single_witness_integral_forms_long),
      (``run87_fused_star_inequality, ``Data.run87_fused_integral_forms_long)] do
    let info ← Lean.getConstInfo name
    let same ← Lean.Elab.Command.liftTermElabM do
      Lean.Meta.isDefEq baseline.type info.type
    unless same && baseline.levelParams == info.levelParams do
      Lean.throwError "RUN88 complete original star statement changed"
    let some body := info.value? (allowOpaque := true) |
      Lean.throwError "RUN88 missing candidate star body"
    let deps := body.getUsedConstants
    unless deps.contains supplier && deps.contains ``Data.exists_family_covolumeSq_le do
      Lean.throwError "RUN88 missing actual A/B/C supplier"
    if deps.contains ``Data.integral_forms_long || deps.contains ``run88_original_star_inequality then
      Lean.throwError "RUN88 candidate uses original direct alias"
    Lean.logInfo m!"RUN88_STAR_COMPARISON: {name}: complete original statement; exact named suppliers"
    for dep in originalValue.getUsedConstants do
      unless deps.contains dep do
        Lean.logInfo m!"RUN88_DIRECT_ORIGINAL_ONLY: {name}: {dep}"
    for dep in deps do
      unless originalValue.getUsedConstants.contains dep do
        Lean.logInfo m!"RUN88_DIRECT_CANDIDATE_ONLY: {name}: {dep}"
