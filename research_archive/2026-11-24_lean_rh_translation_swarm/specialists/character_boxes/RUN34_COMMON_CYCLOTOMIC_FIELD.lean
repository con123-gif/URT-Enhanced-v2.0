namespace RHCharacter34

-- Common-ambient step. All field/type and exponent hypotheses are explicit.
theorem fieldRange_eq_of_common_fix
    {E1 E2 L : Type} [Field E1] [Field E2] [Field L]
    [Algebra ℚ E1] [Algebra ℚ E2] [Algebra ℚ L]
    [FiniteDimensional ℚ L] [IsGalois ℚ L]
    (j1 : E1 →ₐ[ℚ] L) (j2 : E2 →ₐ[ℚ] L) (K : ℕ → Prop)
    (z1 z2 : L)
    (hcommon : ∀ τ : L ≃ₐ[ℚ] L, ∃ a : ℕ,
      τ z1 = z1 ^ a ∧ τ z2 = z2 ^ a)
    (h1 : ∀ (τ : L ≃ₐ[ℚ] L) (a : ℕ), τ z1 = z1 ^ a →
      ((∀ x : E1, τ (j1 x) = j1 x) ↔ K a))
    (h2 : ∀ (τ : L ≃ₐ[ℚ] L) (a : ℕ), τ z2 = z2 ^ a →
      ((∀ x : E2, τ (j2 x) = j2 x) ↔ K a)) :
    j1.fieldRange = j2.fieldRange := by
  have hs : j1.fieldRange.fixingSubgroup = j2.fieldRange.fixingSubgroup := by
    ext τ
    rw [IntermediateField.mem_fixingSubgroup_iff,
        IntermediateField.mem_fixingSubgroup_iff]
    obtain ⟨a, ha, hb⟩ := hcommon τ
    constructor
    · intro h x hx
      obtain ⟨b, rfl⟩ := (j2.mem_fieldRange).mp hx
      exact (h2 τ a hb).2 ((h1 τ a ha).1 (fun v => h _ ⟨v, rfl⟩)) b
    · intro h x hx
      obtain ⟨b, rfl⟩ := (j1.mem_fieldRange).mp hx
      exact (h1 τ a ha).2 ((h2 τ a hb).1 (fun v => h _ ⟨v, rfl⟩)) b
  calc
    j1.fieldRange =
        IntermediateField.fixedField j1.fieldRange.fixingSubgroup :=
      (IsGalois.fixedField_fixingSubgroup j1.fieldRange).symm
    _ = IntermediateField.fixedField j2.fieldRange.fixingSubgroup := by rw [hs]
    _ = j2.fieldRange := IsGalois.fixedField_fixingSubgroup j2.fieldRange

-- Powers of one primitive root have a COMMON automorphism exponent.
theorem common_pow {L : Type} [Field L] [Algebra ℚ L]
    {N : ℕ} [NeZero N] {z : L} (hz : IsPrimitiveRoot z N)
    (r s : ℕ) (τ : L ≃ₐ[ℚ] L) :
    ∃ a : ℕ, τ (z ^ r) = (z ^ r) ^ a ∧ τ (z ^ s) = (z ^ s) ^ a := by
  let a : ℕ := (hz.autToPow ℚ τ : ZMod N).val
  have ha : τ z = z ^ a := (hz.autToPow_spec ℚ τ).symm
  refine ⟨a, ?_, ?_⟩
  · calc
      τ (z ^ r) = (τ z) ^ r := map_pow τ z r
      _ = (z ^ a) ^ r := by rw [ha]
      _ = (z ^ r) ^ a := by simp only [← pow_mul, Nat.mul_comm a r]
  · calc
      τ (z ^ s) = (τ z) ^ s := map_pow τ z s
      _ = (z ^ a) ^ s := by rw [ha]
      _ = (z ^ s) ^ a := by simp only [← pow_mul, Nat.mul_comm a s]

-- Exact predicate from IsChiField. Restrictions from the original witness
-- cyclotomic fields to the common ambient must still be formalized.
def chiKernel (ψ : PChar) (e q d a : ℕ) : Prop :=
  (a ≡ 1 [MOD 2 ^ (e + 2)] ∨ a + 1 ≡ 0 [MOD 2 ^ (e + 2)]) ∧
  ψ.val a = 1 ∧ jacobiSym (a : ℤ) q = 1 ∧ jacobiSym (a : ℤ) d = 1

theorem chiField_common_ambient
    {E1 E2 L : Type} [Field E1] [Field E2] [Field L]
    [Algebra ℚ E1] [Algebra ℚ E2] [Algebra ℚ L]
    [FiniteDimensional ℚ L] [IsGalois ℚ L]
    (ψ : PChar) (e q d : ℕ)
    (j1 : E1 →ₐ[ℚ] L) (j2 : E2 →ₐ[ℚ] L)
    {N : ℕ} [NeZero N] {z : L} (hz : IsPrimitiveRoot z N)
    (r s : ℕ)
    (h1 : ∀ (τ : L ≃ₐ[ℚ] L) (a : ℕ),
      τ (z ^ r) = (z ^ r) ^ a →
      ((∀ x : E1, τ (j1 x) = j1 x) ↔ chiKernel ψ e q d a))
    (h2 : ∀ (τ : L ≃ₐ[ℚ] L) (a : ℕ),
      τ (z ^ s) = (z ^ s) ^ a →
      ((∀ x : E2, τ (j2 x) = j2 x) ↔ chiKernel ψ e q d a)) :
    Nonempty (E1 ≃ₐ[ℚ] E2) := by
  have heq := fieldRange_eq_of_common_fix j1 j2 (chiKernel ψ e q d)
    (z ^ r) (z ^ s) (common_pow hz r s) h1 h2
  exact ⟨j1.equivFieldRange.trans
    ((IntermediateField.equivOfEq heq).trans j2.equivFieldRange.symm)⟩

-- The missing cohomological transfer is a visible hypothesis, not an axiom.
theorem vAt_of_one_field
    (ψ : PChar) (eps Ct : ℝ) (q d e : ℕ) (x : ℝ)
    (E0 : Type) [Field E0] [NumberField E0]
    (hIso : ∀ (E : Type) [Field E] [NumberField E],
      IsChiField ψ e q d E → Nonempty (E0 ≃ₐ[ℚ] E))
    (hTransport : ∀ (E : Type) [Field E] [NumberField E],
      (E0 ≃ₐ[ℚ] E) →
      VVle E0 ⌊x ^ Ct⌋₊ (Real.sqrt (Real.exp (x ^ eps))) →
      VVle E ⌊x ^ Ct⌋₊ (Real.sqrt (Real.exp (x ^ eps))))
    (h0 : VVle E0 ⌊x ^ Ct⌋₊ (Real.sqrt (Real.exp (x ^ eps)))) :
    VAt ψ eps Ct q d e x := by
  intro E _ _ hE
  obtain ⟨i⟩ := hIso E hE
  first
  | rh_reduce 2 using [hTransport E i]
  | rh_auto 1
  | exact hTransport E i h0

end RHCharacter34

