namespace RHGaloisRun71

theorem exact_common_correction {R : Type*} [CommRing R]
    (D s alpha beta f t r v gf gt d : R)
    (h : D * (s + beta*f) = alpha*(gf-f))
    (ht : gt-t = D*v)
    (hd : D*d = gf-f-r*(gt-t)) :
    D*(alpha*d-beta*(f-r*t)) = D*(s-r*(alpha*v-beta*t)) := by
  linear_combination alpha*hd - h - alpha*r*ht

