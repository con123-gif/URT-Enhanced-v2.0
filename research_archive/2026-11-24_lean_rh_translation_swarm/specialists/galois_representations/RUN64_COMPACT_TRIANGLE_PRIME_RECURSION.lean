namespace RHGaloisRun64

theorem law_weight_factor {R : Type*} [CommRing R] (m x y : R) :
    m*x - m*y = m*(x-y) := by ring

theorem double_coboundary_cancel {R : Type*} [CommRing R]
    (A B x y : R) :
    2*((y + B*x) - (x + A*y)) =
      2*((B-1)*x - (A-1)*y) := by ring

theorem odd_even_shift {R : Type*} [CommRing R] (g u : R) :
    g + (-g) + (u - (-u)) = 2*u := by ring

#print axioms law_weight_factor
#print axioms double_coboundary_cancel
#print axioms odd_even_shift
