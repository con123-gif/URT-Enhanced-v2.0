namespace RHGaloisRun59

theorem localBudget (f n c s : ℝ) (hf : 1 ≤ f) (hn : 0 ≤ n)
    (hc : 0 ≤ c) (hs : s ≤ 4*f) :
    (s+3)*n*c ≤ 10*f*n*c := by
  have h : s+3 ≤ 10*f := by linarith
  exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h hn) hc

theorem mirror_discrepancy {R : Type*} [CommRing R] (a q : R) (k : ℕ) :
    a - q*(q^k*a) = a*(1-q^(k+1)) := by
  rw [pow_succ]
  ring

#print axioms localBudget
#print axioms mirror_discrepancy
