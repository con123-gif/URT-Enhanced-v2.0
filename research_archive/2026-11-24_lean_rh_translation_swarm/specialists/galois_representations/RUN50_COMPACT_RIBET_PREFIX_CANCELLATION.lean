namespace CompactRibetRun50

theorem prefix_replace {R : Type*} [CommRing R] (I : Ideal R)
    (d b : ℕ → R) (n : ℕ)
    (h : ∀ k < n, (∏ i ∈ Finset.range k, b i) * (d k - b k) ∈ I) :
    (∏ i ∈ Finset.range n, d i) - (∏ i ∈ Finset.range n, b i) ∈ I := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hp := ih (fun k hk => h k (Nat.lt_trans hk (Nat.lt_succ_self n)))
    have h1 := I.mul_mem_left (d n) hp
    have h2 := h n (Nat.lt_succ_self n)
    rw [Finset.prod_range_succ, Finset.prod_range_succ]
    convert I.add_mem h1 h2 using 1 <;> ring

theorem scalar_prefix_replace {R : Type*} [CommRing R] (I : Ideal R)
    (d b : ℕ → R) (n : ℕ) (D : R)
    (h : ∀ k < n, (∏ i ∈ Finset.range k, b i) * (d k - b k) ∈ I) :
    D * (∏ i ∈ Finset.range n, d i) -
      D * (∏ i ∈ Finset.range n, b i) ∈ I := by
  have H := I.mul_mem_left D (prefix_replace I d b n h)
  simpa only [mul_sub] using H

#print axioms prefix_replace
#print axioms scalar_prefix_replace

