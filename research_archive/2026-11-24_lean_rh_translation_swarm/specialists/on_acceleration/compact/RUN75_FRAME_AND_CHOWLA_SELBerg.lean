theorem clear_frame_denominator (a delta db M H : ℂ) (hdb : db ≠ 0) :
    (delta*db)*M*(-a/db*H) = -a*delta*(M*H) := by
  field_simp [hdb] <;> ring

theorem period_log_aggregate (h a U D w : ℝ)
    (hw : 12*h*w = 12*U+D) :
    h*(a+2*w) = h*a+2*U+D/6 := by
  linear_combination hw / 6

theorem period_derivative_match (h a U D w k pi g L : ℝ) (hh : h ≠ 0)
    (hw : 12*h*w=12*U+D)
    (hd : 2*g*h-(h*a+2*U+D/6-h*(k+2*pi))=h*(g+L)) :
    a+2*w = k+2*pi+g-L := by
  apply (mul_left_cancel₀ hh)
  linear_combination hw / 6 - hd

