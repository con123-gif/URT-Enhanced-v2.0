+#!/usr/bin/env python3
+"""Exact fixed-point and basin-boundary audit for the archived URTF operator."""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+from scipy.optimize import brentq
+
+PHI = (1.0 + math.sqrt(5.0)) / 2.0
+KAPPA = math.pi / PHI
+
+
+def scale(delta: float) -> float:
+    return 1.0 + KAPPA * delta**2
+
+
+def operator(x: float, delta: float) -> float:
+    return (x - delta * math.tanh(x / delta)) * scale(delta)
+
+
+def separatrix(delta: float) -> float:
+    coefficient = (scale(delta) - 1.0) / scale(delta)
+
+    def equation(y: float) -> float:
+        return math.tanh(y) - coefficient * y
+
+    grid = np.geomspace(1.0e-5, max(4.0, 2.0 / coefficient), 2000)
+    previous_y = float(grid[0])
+    previous_value = equation(previous_y)
+    for current in grid[1:]:
+        current_y = float(current)
+        current_value = equation(current_y)
+        if previous_value > 0.0 and current_value < 0.0:
+            return delta * brentq(equation, previous_y, current_y)
+        previous_y = current_y
+        previous_value = current_value
+    raise RuntimeError("No positive nonzero fixed point")
+
+
+def derivative(x: float, delta: float) -> float:
+    return scale(delta) * math.tanh(x / delta) ** 2
+
+
+if __name__ == "__main__":
+    delta_star = (80.0 / 81.0) * math.pi / (13.0 * PHI)
+    delta_classic = 3.0 / 20.0
+    for name, delta in (("delta_star", delta_star), ("delta_classic", delta_classic)):
+        x_c = separatrix(delta)
+        print(name, delta)
+        print("  scale =", scale(delta))
+        print("  x_c =", x_c)
+        print("  derivative at zero =", derivative(0.0, delta))
+        print("  derivative at x_c =", derivative(x_c, delta))
