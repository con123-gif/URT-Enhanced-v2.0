+#!/usr/bin/env python3
+"""Reproduce the frozen weekly constants and expose unresolved differences."""
+from __future__ import annotations
+
+import json
+from math import pi, sqrt
+from pathlib import Path
+
+D = 3
+N = 13
+F = 20
+PHI = (1.0 + sqrt(5.0)) / 2.0
+GAMMA = 1.0 / 81.0
+DELTA_STAR_GEOM = (1.0 - GAMMA) * pi / (N * PHI)
+DELTA_CLASSIC = D / F
+DELTA_GEOM = DELTA_CLASSIC - DELTA_STAR_GEOM
+
+R_TARGET = 3.8417002878419497
+CYCLE_ARCHIVED = (
+    0.1474219361622878,
+    0.1500067276982269,
+    0.4828583491613422,
+    0.4898348785861162,
+    0.9592962413714381,
+    0.9600281102477677,
+)
+
+
+def root_alpha_inverse(delta: float = DELTA_GEOM) -> float:
+    return 137.0 + (17572.0 / 1215.0) * delta - (9.0 / 65.0) * delta * delta
+
+
+def audit() -> dict[str, float | list[float]]:
+    return {
+        "phi": PHI,
+        "gamma": GAMMA,
+        "delta_star_geometric": DELTA_STAR_GEOM,
+        "delta_classic": DELTA_CLASSIC,
+        "Delta_geometric": DELTA_GEOM,
+        "r_target": R_TARGET,
+        "cycle": list(CYCLE_ARCHIVED),
+        "Delta_cycle": CYCLE_ARCHIVED[1] - CYCLE_ARCHIVED[0],
+        "delta_star_difference": DELTA_STAR_GEOM - CYCLE_ARCHIVED[0],
+        "alpha_root_inverse": root_alpha_inverse(),
+    }
+
+
+if __name__ == "__main__":
+    report = audit()
+    print(json.dumps(report, indent=2))
+    out = Path(__file__).with_name("weekly_constants_audit.json")
+    out.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
