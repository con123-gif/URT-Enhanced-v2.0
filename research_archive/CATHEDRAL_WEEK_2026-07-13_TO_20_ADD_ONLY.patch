+from math import isclose, pi, sqrt
+
+
+def test_geometric_rails_and_gap():
+    phi = (1.0 + sqrt(5.0)) / 2.0
+    delta_star = (80.0 / 81.0) * pi / (13.0 * phi)
+    delta_classic = 3.0 / 20.0
+    gap = delta_classic - delta_star
+    assert isclose(delta_star, 0.14751081015957962, rel_tol=0.0, abs_tol=1e-15)
+    assert isclose(gap, 0.002489189840420375, rel_tol=0.0, abs_tol=1e-15)
+
+
+def test_geometric_and_archived_logistic_values_are_not_identical():
+    phi = (1.0 + sqrt(5.0)) / 2.0
+    geometric = (80.0 / 81.0) * pi / (13.0 * phi)
+    archived_cycle = 0.1474219361622878
+    assert isclose(geometric - archived_cycle, 8.887399729182177e-05, rel_tol=0.0, abs_tol=1e-16)
+    assert geometric != archived_cycle
+
+
+def test_root_coupling_polynomial():
+    phi = (1.0 + sqrt(5.0)) / 2.0
+    gap = 3.0 / 20.0 - (80.0 / 81.0) * pi / (13.0 * phi)
+    alpha_inverse = 137.0 + (17572.0 / 1215.0) * gap - (9.0 / 65.0) * gap**2
+    assert isclose(alpha_inverse, 137.035999178195, rel_tol=0.0, abs_tol=1e-12)
+
+
+def test_charge_word_shape_ratio_and_slot_are_close_not_equal():
+    ratio = 0.12835635776165666
+    slot = 1.0 / 8.0 + 1.0 / 243.0
+    assert isclose((slot - ratio) / slot, 0.00587745223641, rel_tol=0.0, abs_tol=1e-12)
+    assert ratio != slot