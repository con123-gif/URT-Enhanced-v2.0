+#!/usr/bin/env python3
+"""Target-free audit of the archived URT rail claim."""
+from __future__ import annotations
+
+import math
+from pathlib import Path
+
+import matplotlib.pyplot as plt
+import numpy as np
+import pandas as pd
+
+ALPHA = 1.155
+THETA_H = 2.4
+
+
+def raw_urt_estimator(x: np.ndarray) -> tuple[float, float, float]:
+    x = np.asarray(x, dtype=float).ravel()
+    if x.size < 40 or not np.all(np.isfinite(x)):
+        return math.nan, math.nan, math.nan
+    sigma = float(np.std(x))
+    if sigma < 1.0e-12:
+        return math.nan, math.nan, math.nan
+    x = (x - np.mean(x)) / (sigma + 1.0e-10)
+    acf = np.correlate(x - np.mean(x), x - np.mean(x), mode="full")
+    acf = acf[acf.size // 2 :]
+    if abs(acf[0]) < 1.0e-15:
+        return math.nan, math.nan, math.nan
+    acf /= acf[0]
+    hits = np.where(acf < math.exp(-1.0))[0]
+    decay_lag = int(hits[0]) if hits.size else len(acf) // 10
+    dimension = 1.0 + 2.0 / (1.0 + math.exp(-decay_lag / 10.0))
+    dimension = max(1.0, min(dimension, 5.0))
+    variances = [np.var(x[index::20]) for index in range(20)]
+    tau = 2.0 + 0.5 * np.mean(variances) / (np.std(variances) + 1.0e-10)
+    tau = max(1.5, min(tau, 3.5))
+    delta = (dimension - 1.0) * (tau - 2.0)
+    delta = max(0.01, min(delta, 1.0))
+    return float(delta), float(dimension), float(tau)
+
+
+def archived_refinement(delta: float) -> float:
+    for index in range(30):
+        kappa = delta**2 / (1.0 + delta**2)
+        delta -= 0.5 * math.exp(-index / 8.0) * (delta - 0.15) * (1.0 + kappa)
+        delta = max(0.001, min(delta, 0.5))
+    return float(delta)
+
+
+def logistic_map(r: float, n: int = 3000, x0: float = 0.123456) -> np.ndarray:
+    x = np.empty(n)
+    x[0] = x0
+    for index in range(1, n):
+        x[index] = r * x[index - 1] * (1.0 - x[index - 1])
+    return x
+
+
+def tent_map(m: float, n: int = 3000, x0: float = 0.123456) -> np.ndarray:
+    x = np.empty(n)
+    x[0] = x0
+    for index in range(1, n):
+        previous = x[index - 1]
+        x[index] = m * previous if previous < 0.5 else m * (1.0 - previous)
+    return x
+
+
+def henon_map(
+    a: float,
+    b: float = 0.3,
+    n: int = 3000,
+    x0: float = 0.1,
+    y0: float = 0.1,
+) -> np.ndarray | None:
+    x = np.empty(n)
+    y = np.empty(n)
+    x[0], y[0] = x0, y0
+    for index in range(1, n):
+        x[index] = 1.0 - a * x[index - 1] ** 2 + y[index - 1]
+        y[index] = b * x[index - 1]
+        if not np.isfinite(x[index]) or abs(x[index]) > 1.0e6:
+            return None
+    return x
+
+
+def run() -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
+    rows: list[dict[str, float | str]] = []
+    for r in np.linspace(3.57, 4.0, 220):
+        delta, dimension, tau = raw_urt_estimator(logistic_map(float(r))[500:])
+        rows.append({"system": "logistic", "parameter": r, "delta_raw": delta, "D": dimension, "tau": tau})
+    for m in np.linspace(1.5, 1.999, 220):
+        delta, dimension, tau = raw_urt_estimator(tent_map(float(m))[500:])
+        rows.append({"system": "tent", "parameter": m, "delta_raw": delta, "D": dimension, "tau": tau})
+    for a in np.linspace(1.1, 1.42, 220):
+        x = henon_map(float(a))
+        if x is not None:
+            delta, dimension, tau = raw_urt_estimator(x[500:])
+            rows.append({"system": "henon", "parameter": a, "delta_raw": delta, "D": dimension, "tau": tau})
+    raw = pd.DataFrame(rows)
+    summary = raw.groupby("system")["delta_raw"].agg(
+        count="count", mean="mean", std="std", minimum="min", median="median", maximum="max"
+    ).reset_index()
+    audit = pd.DataFrame(
+        [
+            {
+                "quantity": "global sufficient contraction threshold beta",
+                "value": 1.0 / (ALPHA * (1.0 + THETA_H)),
+            },
+            {
+                "quantity": "local zero fixed-point stability threshold beta",
+                "value": 1.0 / (ALPHA * abs(1.0 - THETA_H)),
+            },
+            {
+                "quantity": "local multiplier magnitude at beta=0.1475",
+                "value": abs(0.1475 * ALPHA * (1.0 - THETA_H)),
+            },
+            {
+                "quantity": "local multiplier magnitude at beta=0.1500",
+                "value": abs(0.1500 * ALPHA * (1.0 - THETA_H)),
+            },
+        ]
+    )
+    return raw, summary, audit
+
+
+if __name__ == "__main__":
+    output = Path(__file__).resolve().parent
+    raw, summary, audit = run()
+    print("\nRAW ESTIMATOR SUMMARY")
+    print(summary.to_string(index=False))
+    print("\nORIGINAL URT MAP THRESHOLDS")
+    print(audit.to_string(index=False))
+    print("\nARCHIVED REFINEMENT TEST")
+    for initial in (0.001, 0.01, 0.05, 0.1475, 0.15, 0.3, 0.5, 1.0):
+        print(f"{initial:8.4f} -> {archived_refinement(initial):.12f}")
+    summary.to_csv(output / "urt_target_free_audit_summary.csv", index=False)
+    figure, axis = plt.subplots(figsize=(8, 5))
+    for system, group in raw.groupby("system"):
+        axis.scatter(group["parameter"], group["delta_raw"], s=9, alpha=0.55, label=system)
+    axis.axhline(0.1475, linestyle="--", linewidth=1.2, label="claimed lower rail")
+    axis.axhline(0.1500, linestyle=":", linewidth=1.2, label="claimed upper rail")
+    axis.set_xlabel("system parameter")
+    axis.set_ylabel("raw archived delta estimator")
+    axis.set_title("Target-free archived URT estimator")
+    axis.legend()
+    axis.grid(alpha=0.25)
+    figure.tight_layout()
+    figure.savefig(output / "urt_target_free_audit.png", dpi=180)
