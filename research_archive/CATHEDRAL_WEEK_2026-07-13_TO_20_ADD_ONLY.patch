+#!/usr/bin/env python3
+"""Exact A/B charge-word trace audit from the weekly Higgs calculation."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import sqrt
+
+import numpy as np
+
+PHI = (1.0 + sqrt(5.0)) / 2.0
+A_COEFF = PHI / sqrt(3.0)
+B_COEFF = 1.0 / (sqrt(3.0) * PHI)
+
+A = np.array(
+    [[A_COEFF, 0.0, 0.0], [0.0, B_COEFF, 0.0], [0.0, 0.0, 0.0]],
+    dtype=float,
+)
+B = np.array(
+    [[0.0, 0.0, -B_COEFF], [0.0, 0.0, 0.0], [0.0, -A_COEFF, 0.0]],
+    dtype=float,
+)
+
+
+@dataclass(frozen=True)
+class ChargeWord:
+    k: int
+    m: int
+    omega: int
+    colour: int
+
+    @property
+    def lambda_squared(self) -> float:
+        return (18.0 + 7.0 * self.k) / (8.0 * self.k**3)
+
+    @property
+    def p_squared(self) -> float:
+        return 3.0 * self.m**2 * self.lambda_squared
+
+    @property
+    def q_squared(self) -> float:
+        return (self.omega**2 / 25.0) * self.lambda_squared
+
+    def matrix(self) -> np.ndarray:
+        # Signs do not affect the scalar traces, but retain the charge-word signs.
+        p = (1.0 if self.m >= 0 else -1.0) * sqrt(self.p_squared)
+        q = (1.0 if self.omega >= 0 else -1.0) * sqrt(self.q_squared)
+        return p * A + q * B
+
+
+WORDS = {
+    "u": ChargeWord(13, -12, 70, 3),
+    "d": ChargeWord(7, -6, -20, 3),
+    "e": ChargeWord(27, 54, 0, 1),
+    "nu": ChargeWord(9, 0, -54, 1),
+}
+
+
+def traces(matrix: np.ndarray) -> tuple[float, float]:
+    product = matrix @ matrix.conjugate().T
+    return float(np.trace(product).real), float(np.trace(product @ product).real)
+
+
+def aggregate() -> tuple[float, float, float]:
+    y2 = 0.0
+    g2 = 0.0
+    for word in WORDS.values():
+        quadratic, quartic = traces(word.matrix())
+        y2 += word.colour * quadratic
+        g2 += word.colour * quartic
+    return y2, g2, g2 / (y2 * y2)
+
+
+if __name__ == "__main__":
+    print("A norm", np.trace(A @ A.T))
+    print("B norm", np.trace(B @ B.T))
+    print("A.B", np.trace(A @ B.T))
+    for name, word in WORDS.items():
+        quadratic, quartic = traces(word.matrix())
+        print(name, "S=", quadratic, "Q=", quartic, "det=", np.linalg.det(word.matrix()))
+    y2, g2, ratio = aggregate()
+    print("Y2", y2)
+    print("G2", g2)
+    print("G2/Y2^2", ratio)
+    slot = 1.0 / 8.0 + 1.0 / 243.0
+    print("slot", slot)
+    print("relative discrepancy", (slot - ratio) / slot)
