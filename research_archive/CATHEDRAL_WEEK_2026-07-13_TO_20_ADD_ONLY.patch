+from fractions import Fraction
+from math import isclose
+
+import pytest
+
+from newtons_cathedral.higgs_normalization import (
+    SpectralActionConvention,
+    canonical_weak_angle_boundary,
+    cathedral_quartic_slot,
+    diagnostic_report,
+    gauge_trace_ratio,
+    higgs_normalization_audit,
+    higgs_shape_ratio,
+    quartic_boundary,
+    required_normalization_coefficient,
+    yukawa_trace_a,
+    yukawa_trace_b,
+)
+
+
+def test_finite_dirac_heat_traces_are_pinned():
+    assert isclose(yukawa_trace_a(), 21.33357522775238, rel_tol=0.0, abs_tol=1e-12)
+    assert isclose(yukawa_trace_b(), 36.34206561805763, rel_tol=0.0, abs_tol=1e-12)
+    assert isclose(higgs_shape_ratio(), 0.07985136067642659, rel_tol=0.0, abs_tol=1e-14)
+
+
+def test_bare_gauge_trace_boundary_is_three_eighths():
+    assert gauge_trace_ratio() == (Fraction(5, 3), Fraction(1), Fraction(1))
+    assert canonical_weak_angle_boundary() == Fraction(3, 8)
+
+
+def test_action_convention_keeps_prefactor_explicit():
+    convention = SpectralActionConvention(A_W=1.0, A_H=2.0, A_V=2.0)
+    assert isclose(convention.normalization_coefficient, 4.0, abs_tol=1e-15)
+
+
+def test_old_cathedral_slot_requires_nontrivial_normalization():
+    report = diagnostic_report()
+    required = required_normalization_coefficient(
+        cathedral_quartic_slot(), report["cathedral_g2_squared"]
+    )
+    assert isclose(required, 4.069095184887046, rel_tol=0.0, abs_tol=1e-12)
+    prediction = quartic_boundary(
+        report["cathedral_g2_squared"], normalization_coefficient=4.0
+    )
+    assert isclose(prediction, 0.12692278796229, rel_tol=0.0, abs_tol=1e-12)
+
+
+def test_invalid_conventions_are_rejected():
+    with pytest.raises(ValueError):
+        SpectralActionConvention(A_W=0.0, A_H=1.0, A_V=1.0)
+
+
+def test_complete_audit():
+    assert higgs_normalization_audit()
