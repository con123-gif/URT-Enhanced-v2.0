+#!/usr/bin/env python3
+"""Reproduce the archived attracting six-cycle and compare both rail definitions."""
+from __future__ import annotations
+
+from math import log, pi, sqrt
+
+R_TARGET = 3.8417002878419497
+ARCHIVED_DELTA_STAR = 0.14742193616230046
+
+
+def logistic(x: float, r: float) -> float:
+    return r * x * (1.0 - x)
+
+
+def attractor(
+    r: float,
+    *,
+    transient: int = 200_000,
+    samples: int = 200,
+    tolerance: float = 1.0e-12,
+) -> list[float]:
+    x = 0.5
+    for _ in range(transient):
+        x = logistic(x, r)
+    points: list[float] = []
+    for _ in range(samples):
+        x = logistic(x, r)
+        if not any(abs(x - prior) < tolerance for prior in points):
+            points.append(x)
+    return sorted(points)
+
+
+def lyapunov(r: float, *, transient: int = 10_000, samples: int = 100_000) -> float:
+    x = 0.3
+    for _ in range(transient):
+        x = logistic(x, r)
+    total = 0.0
+    for _ in range(samples):
+        x = logistic(x, r)
+        total += log(abs(r * (1.0 - 2.0 * x)))
+    return total / samples
+
+
+def cycle_lyapunov(cycle: list[float], r: float) -> float:
+    return sum(log(abs(r * (1.0 - 2.0 * x))) for x in cycle) / len(cycle)
+
+
+def geometric_delta_star() -> float:
+    phi = (1.0 + sqrt(5.0)) / 2.0
+    return (80.0 / 81.0) * pi / (13.0 * phi)
+
+
+if __name__ == "__main__":
+    cycle = attractor(R_TARGET)
+    print("cycle")
+    for index, point in enumerate(cycle, 1):
+        print(index, f"{point:.16f}")
+    print("archived lower-branch error", abs(cycle[0] - ARCHIVED_DELTA_STAR))
+    print("finite-sample Lyapunov", lyapunov(R_TARGET))
+    print("six-cycle Lyapunov", cycle_lyapunov(cycle, R_TARGET))
+    print("cycle lower-pair gap", cycle[1] - cycle[0])
+    print("geometric delta_star", geometric_delta_star())
+    print("geometric minus cycle", geometric_delta_star() - cycle[0])
